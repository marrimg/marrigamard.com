{
  "name": "marrigamard-com",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
     "binding": "ASSETS",
         // Redirects all non-file requests to index.html for SPA routing
    "not_found_handling": "single-page-application" 
  },
  "r2_buckets": [
    {
      "binding": "images_bucket",          // The variable name you will use in your code
      "bucket_name": "images" // The actual name of your bucket in Cloudflare
    }]
}
